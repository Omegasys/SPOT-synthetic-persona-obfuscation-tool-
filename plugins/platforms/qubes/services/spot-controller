#!/bin/sh
#
# SPOT Qubes RPC service: spot-controller
#
# This service intentionally accepts only a small fixed command set.
# It must not become a generic shell or command-execution interface.

set -eu

COMMAND="${1:-}"

case "$COMMAND" in
    status)
        exec /usr/bin/python3 -m spot status
        ;;

    start)
        exec /usr/bin/python3 -m spot start
        ;;

    stop)
        exec /usr/bin/python3 -m spot stop
        ;;

    emergency-stop)
        exec /usr/bin/python3 -m spot emergency-stop
        ;;

    reset-emergency-stop)
        exec /usr/bin/python3 -m spot reset-emergency-stop
        ;;

    *)
        echo "Denied: unsupported SPOT controller operation." >&2
        exit 1
        ;;
esac
