#!/bin/sh

# SPOT Persona Qubes RPC endpoint.
#
# Requests are deliberately limited to persona lifecycle operations.
# Arbitrary commands, paths, credentials, and Qubes administration
# requests are not accepted.

set -eu

REQUEST="$(cat)"

case "$REQUEST" in
    start)
        exec /usr/bin/python3 -m spot persona start
        ;;

    stop)
        exec /usr/bin/python3 -m spot persona stop
        ;;

    status)
        exec /usr/bin/python3 -m spot persona status
        ;;

    emergency-stop)
        exec /usr/bin/python3 -m spot persona emergency-stop
        ;;

    *)
        echo "Denied: unknown SPOT persona operation." >&2
        exit 1
        ;;
esac
